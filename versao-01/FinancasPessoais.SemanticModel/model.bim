{
  "name": "FinancasPessoais",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "pt-BR",
    "sourceQueryCulture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "CaminhoPlanilha",
        "kind": "m",
        "expression": "\"CONFIGURAR\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true]"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"CaminhoPlanilha\",\"Lançamentos\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "tables": [
      {
        "name": "Lançamentos",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "Tipo",
            "dataType": "string",
            "sourceColumn": "Tipo",
            "summarizeBy": "none"
          },
          {
            "name": "Categoria",
            "dataType": "string",
            "sourceColumn": "Categoria",
            "summarizeBy": "none"
          },
          {
            "name": "Descrição",
            "dataType": "string",
            "sourceColumn": "Descrição",
            "summarizeBy": "none"
          },
          {
            "name": "Valor",
            "dataType": "decimal",
            "sourceColumn": "Valor",
            "summarizeBy": "none",
            "formatString": "\"R$\" #,##0.00;-\"R$\" #,##0.00"
          }
        ],
        "partitions": [
          {
            "name": "Lançamentos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Dados = if CaminhoPlanilha = \"CONFIGURAR\" then",
                "        #table({\"Data\", \"Tipo\", \"Categoria\", \"Descrição\", \"Valor\"}, {})",
                "    else",
                "        Excel.Workbook(File.Contents(CaminhoPlanilha), null, true){[Item = \"Lancamentos\", Kind = \"Table\"]}[Data],",
                "    Colunas = Table.SelectColumns(Dados, {\"Data\", \"Tipo\", \"Categoria\", \"Descrição\", \"Valor\"}),",
                "    Preenchidos = Table.SelectRows(Colunas, each List.NonNullCount(",
                "        List.Transform(Record.FieldValues(_), each if Value.Is(_, type text) and Text.Trim(_) = \"\" then null else _)",
                "    ) > 0),",
                "    Tipados = Table.TransformColumnTypes(Preenchidos, {",
                "        {\"Data\", type date}, {\"Tipo\", type text}, {\"Categoria\", type text}, {\"Descrição\", type text}, {\"Valor\", Currency.Type}",
                "    }, \"pt-BR\"),",
                "    Textos = Table.TransformColumns(Tipados, List.Transform({\"Tipo\", \"Categoria\", \"Descrição\"}, each {_, Text.Trim, type text})),",
                "    Invalidos = Table.SelectRows(Textos, each",
                "        [Data] = null or [Data] < #date(1900, 3, 1) or [Data] > #date(9998, 12, 31) or",
                "        not List.Contains({\"Despesa\", \"Receita\", \"Saldo inicial\", \"Aporte\", \"Resgate\"}, [Tipo]) or",
                "        [Categoria] = null or [Categoria] = \"\" or [Descrição] = null or [Descrição] = \"\" or",
                "        [Valor] = null or [Valor] <= 0),",
                "    Resultado = if Table.IsEmpty(Invalidos) then Textos else",
                "        error \"Preencha data, tipo, categoria, descrição e valor positivo em todas as linhas iniciadas da tabela Lancamentos.\"",
                "in",
                "    Resultado"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Despesas",
            "expression": [
              "CALCULATE(SUM('Lançamentos'[Valor]), KEEPFILTERS('Lançamentos'[Tipo] = \"Despesa\"))"
            ],
            "formatString": "\"R$\" #,##0.00;-\"R$\" #,##0.00"
          },
          {
            "name": "Receitas",
            "expression": [
              "COALESCE(CALCULATE(SUM('Lançamentos'[Valor]), KEEPFILTERS('Lançamentos'[Tipo] = \"Receita\")), 0)"
            ],
            "formatString": "\"R$\" #,##0.00;-\"R$\" #,##0.00"
          },
          {
            "name": "Resultado do período",
            "expression": [
              "[Receitas] - COALESCE([Despesas], 0)"
            ],
            "formatString": "\"R$\" #,##0.00;-\"R$\" #,##0.00"
          },
          {
            "name": "Movimento da reserva",
            "expression": [
              "CALCULATE(SUM('Lançamentos'[Valor]), KEEPFILTERS('Lançamentos'[Tipo] IN {\"Saldo inicial\", \"Aporte\"})) -",
              "CALCULATE(SUM('Lançamentos'[Valor]), KEEPFILTERS('Lançamentos'[Tipo] = \"Resgate\"))"
            ],
            "isHidden": true
          },
          {
            "name": "Reserva acumulada",
            "expression": [
              "VAR DataLimite = MAX('Calendário'[Date])",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(DataLimite),",
              "        COALESCE(",
              "            CALCULATE([Movimento da reserva], FILTER(ALL('Calendário'), 'Calendário'[Date] <= DataLimite)),",
              "            0",
              "        )",
              "    )"
            ],
            "formatString": "\"R$\" #,##0.00;-\"R$\" #,##0.00"
          }
        ]
      },
      {
        "name": "Calendário",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Date]",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "type": "calculatedTableColumn",
            "name": "Mês",
            "dataType": "string",
            "isNameInferred": false,
            "isDataTypeInferred": false,
            "sourceColumn": "[Mês]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Calendário",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR PrimeiraData = COALESCE(MIN('Lançamentos'[Data]), TODAY())",
                "VAR UltimaData = COALESCE(MAX('Lançamentos'[Data]), PrimeiraData)",
                "RETURN",
                "    ADDCOLUMNS(",
                "        CALENDAR(DATE(YEAR(PrimeiraData), MONTH(PrimeiraData), 1), EOMONTH(UltimaData, 0)),",
                "        \"Mês\", FORMAT([Date], \"yyyy-MM\")",
                "    )"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "DataLancamento",
        "fromTable": "Lançamentos",
        "fromColumn": "Data",
        "toTable": "Calendário",
        "toColumn": "Date"
      }
    ]
  }
}
